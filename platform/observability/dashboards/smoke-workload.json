{
  "uid": "platform-smoke-workload",
  "title": "Platform / Smoke workload",
  "description": "Phase 6.1b: apps/smoke request rate, server errors, latency and running version per environment.",
  "tags": [
    "platform",
    "phase-6.1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hub-prometheus"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(up, cluster)",
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by cluster and route",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "sum by (cluster, route) (rate(http_requests_total{job=\"workload\",cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Share of requests answered 5xx, by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "(sum by (cluster) (rate(http_requests_total{job=\"workload\",cluster=~\"$cluster\",code=~\"5..\"}[5m])) or 0 * sum by (cluster) (rate(http_requests_total{job=\"workload\",cluster=~\"$cluster\"}[5m]))) / sum by (cluster) (rate(http_requests_total{job=\"workload\",cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95, by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (cluster, le) (rate(http_request_duration_seconds_bucket{job=\"workload\",cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Available replicas, by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "sum by (cluster, deployment) (kube_deployment_status_replicas_available{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Running version, by cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "max by (cluster, version) (smoke_build_info{cluster=~\"$cluster\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
