{
  "uid": "platform-argocd",
  "title": "Platform / Argo CD",
  "description": "Phase 6.1c: the hub's Argo CD applications (health, sync, sync operations) and its application controller.",
  "tags": [
    "platform",
    "phase-6.1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Applications by health",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "sum by (health_status) (argocd_app_info{job=\"argocd-application-controller\"})",
          "legendFormat": "{{health_status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Applications by sync status",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "sum by (sync_status) (argocd_app_info{job=\"argocd-application-controller\"})",
          "legendFormat": "{{sync_status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Application controller up",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "up{job=\"argocd-application-controller\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Applications",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "max by (name, project, dest_server, health_status, sync_status) (argocd_app_info{job=\"argocd-application-controller\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sync operations per hour, by application and phase",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "sum by (name, phase) (increase(argocd_app_sync_total{job=\"argocd-application-controller\"}[1h]))",
          "legendFormat": "{{name}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Argo CD alerts firing",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "expr": "ALERTS{alertname=~\"ArgoCD.*\",alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
