<mxfile host="drawio">
  <diagram id="delivery" name="Delivery and promotion">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d-title" value="GitOps delivery and image promotion" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="d-pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;code or overlay change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="d-checks" value="&lt;b&gt;Required checks&lt;/b&gt;&lt;br&gt;validate, emulator,&lt;br&gt;build/scan/SBOM,&lt;br&gt;verify promoted images" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="d-main" value="&lt;b&gt;&lt;code&gt;main&lt;/code&gt;&lt;/b&gt;&lt;br&gt;ruleset: PR required, strict&lt;br&gt;checks, no force push, no bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="d-img" value="&lt;b&gt;image workflow on main&lt;/b&gt;&lt;br&gt;build with tests → Trivy → SBOM →&lt;br&gt;push GHCR → cosign sign → attest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="d-pdev" value="&lt;b&gt;make promote APP=&amp;lt;app&amp;gt; ENV=dev&lt;/b&gt;&lt;br&gt;verifies the signature, writes the&lt;br&gt;overlay digest and a ledger row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="d-puat" value="&lt;b&gt;ENV=uat ← dev&lt;/b&gt;&lt;br&gt;same digest, its own PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="d-pprod" value="&lt;b&gt;ENV=prod ← uat&lt;/b&gt;&lt;br&gt;same digest, its own PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="d-argo" value="&lt;b&gt;Argo CD on the hub&lt;/b&gt;&lt;br&gt;ApplicationSet per component,&lt;br&gt;clusters generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="d-dev" value="dev spoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="450" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="d-ea0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-argo" target="d-dev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-uat" value="uat spoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="d-ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-argo" target="d-uat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-prod" value="prod spoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="450" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="d-ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-argo" target="d-prod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d-pr" target="d-checks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e2" value="all green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d-checks" target="d-main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d-main" target="d-img"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e4" value="signed digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-img" target="d-pdev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-pdev" target="d-puat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d-puat" target="d-pprod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d-e7" value="each step opens a promotion PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="d-pdev" target="d-pr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="235"/><mxPoint x="790" y="170"/><mxPoint x="80" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="d-e8" value="pulled, never pushed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="d-main" target="d-argo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="290"/><mxPoint x="600" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="d-note" value="Rollback is a &lt;code&gt;git revert&lt;/code&gt; through the same pull request path. The ApplicationSet generates Applications; it never approves anything: approval is the pull request plus the AppProject and each spoke's namespace-scoped Role. Ledgers: &lt;code&gt;gitops/promotions/&amp;lt;app&amp;gt;.tsv&lt;/code&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="760" height="50" as="geometry"/></mxCell>
        <mxCell id="delivery-legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1140" y="50" width="260" height="142" as="geometry"/></mxCell>
        <mxCell id="delivery-lg0" value="Implemented, runs in the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1152" y="82" width="236" height="28" as="geometry"/></mxCell>
        <mxCell id="delivery-lg1" value="External service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1152" y="118" width="236" height="28" as="geometry"/></mxCell>
        <mxCell id="delivery-lg2" value="Required gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1152" y="154" width="236" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
