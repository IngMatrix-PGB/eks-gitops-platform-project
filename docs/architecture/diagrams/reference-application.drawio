        <mxCell id="r-client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;port-forward in the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r-smoke" value="&lt;b&gt;smoke&lt;/b&gt; (Go)&lt;br&gt;:8080 &lt;code&gt;/api/info&lt;/code&gt;, &lt;code&gt;/api/notes&lt;/code&gt;&lt;br&gt;:9090 metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="55" width="240" height="90" as="geometry"/></mxCell>
