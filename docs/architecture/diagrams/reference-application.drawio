        <mxCell id="r-pg" value="&lt;b&gt;postgres&lt;/b&gt; StatefulSet&lt;br&gt;:5432, PostgreSQL 18.6&lt;br&gt;PVC, reclaim Retain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="r-hub" value="&lt;b&gt;Hub alerts&lt;/b&gt;&lt;br&gt;NotesDown, NotesNotReady, PostgresDown,&lt;br&gt;NotesDumpFailed, NotesDumpMissing;&lt;br&gt;smoke SLO includes &lt;code&gt;/api/notes&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="r-eso" value="&lt;b&gt;ESO&lt;/b&gt;&lt;br&gt;&lt;code&gt;eso-source-&amp;lt;env&amp;gt;&lt;/code&gt;: &lt;code&gt;db-&amp;lt;env&amp;gt;&lt;/code&gt;, &lt;code&gt;dumps-&amp;lt;env&amp;gt;&lt;/code&gt;&lt;br&gt;→ password and key files per consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="260" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="r-dump" value="&lt;b&gt;dump CronJob&lt;/b&gt;&lt;br&gt;every 6 h: pg_dump as &lt;code&gt;notes&lt;/code&gt;,&lt;br&gt;rclone upload, keep 72 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="250" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="r-store" value="&lt;b&gt;Lab S3 store&lt;/b&gt;&lt;br&gt;bucket &lt;code&gt;dumps-&amp;lt;env&amp;gt;&lt;/code&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="180" height="80" as="geometry"/></mxCell>
