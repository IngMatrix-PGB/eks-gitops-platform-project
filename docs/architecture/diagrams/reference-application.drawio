        <mxCell id="r-note" value="Every pod is Restricted-PSS. Images are promoted by digest (smoke and notes ledgers). &lt;code&gt;make db-restore-check&lt;/code&gt; restores the newest dump into a throwaway database and compares rows by SHA-256." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="760" height="50" as="geometry"/></mxCell>
