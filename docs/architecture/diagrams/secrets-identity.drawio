<mxfile host="drawio">
  <diagram id="secrets" name="Secrets and identity">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="Secrets and workload identity" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="s-lab" value="Lab (implemented): Kubernetes provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="600" height="340" as="geometry"/></mxCell>
        <mxCell id="s-src" value="&lt;b&gt;Source Secret&lt;/b&gt;&lt;br&gt;namespace &lt;code&gt;eso-source-&amp;lt;env&amp;gt;&lt;/code&gt;,&lt;br&gt;created imperatively, never in Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="s-store" value="&lt;b&gt;SecretStore&lt;/b&gt;&lt;br&gt;Kubernetes provider, own reader&lt;br&gt;ServiceAccount and Role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="s-es" value="&lt;b&gt;ExternalSecret&lt;/b&gt;&lt;br&gt;one per consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="250" height="50" as="geometry"/></mxCell>
        <mxCell id="s-tgt" value="&lt;b&gt;Target Secret&lt;/b&gt;&lt;br&gt;owned by ESO only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="250" height="50" as="geometry"/></mxCell>
        <mxCell id="s-pod" value="&lt;b&gt;Pod&lt;/b&gt;&lt;br&gt;read-only file mount,&lt;br&gt;never an environment variable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="275" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="s-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s-src" target="s-store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-store" target="s-es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-es" target="s-tgt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s-tgt" target="s-pod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-labnote" value="One ESO per spoke; each spoke's ESO reads only its own source namespace." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="345" width="560" height="30" as="geometry"/></mxCell>
        <mxCell id="s-aws" value="AWS (offline-tested, never applied): Secrets Manager through Pod Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#333333;arcSize=4;" vertex="1" parent="1"><mxGeometry x="650" y="50" width="600" height="340" as="geometry"/></mxCell>
        <mxCell id="s-tf" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;code&gt;envs/identity&lt;/code&gt;,&lt;br&gt;one apply per spoke account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="s-kms" value="&lt;b&gt;KMS key&lt;/b&gt;&lt;br&gt;per environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="s-sm" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;secret (metadata only in Terraform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="190" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="s-pia" value="&lt;b&gt;Pod Identity association&lt;/b&gt;&lt;br&gt;(cluster, &lt;code&gt;eso-&amp;lt;env&amp;gt;&lt;/code&gt;, ServiceAccount)&lt;br&gt;→ IAM role scoped to one secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="s-eso" value="&lt;b&gt;ESO controller&lt;/b&gt;&lt;br&gt;SecretsManager provider,&lt;br&gt;no auth block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="305" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="s-tgt2" value="&lt;b&gt;Target Secret&lt;/b&gt; → Pod, as in the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="315" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="s-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="s-tf" target="s-kms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-tf" target="s-pia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-pia" target="s-eso"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e8" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.2;entryX=0;entryY=0.75;" edge="1" parent="1" source="s-eso" target="s-sm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="318"/><mxPoint x="955" y="235"/></Array></mxGeometry></mxCell>
        <mxCell id="s-e9" value="kms:Decrypt only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-kms" target="s-sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="s-eso" target="s-tgt2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s-argo" value="&lt;b&gt;Hub to spoke&lt;/b&gt;&lt;br&gt;Lab: a namespace-scoped Role and a rotating 24 h token.&lt;br&gt;AWS: the hub's Argo CD role (Pod Identity) assumes each spoke's &lt;code&gt;argocd-manager&lt;/code&gt; role,&lt;br&gt;STANDARD access entry, the same Role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="600" height="80" as="geometry"/></mxCell>
        <mxCell id="s-human" value="&lt;b&gt;Human access (Phase 4, not started)&lt;/b&gt;&lt;br&gt;IAM Identity Center permission sets;&lt;br&gt;Keycloak for the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="420" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="secrets-legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="260" height="142" as="geometry"/></mxCell>
        <mxCell id="secrets-lg0" value="Implemented, runs in the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1002" y="452" width="236" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-lg1" value="AWS: offline-tested, never applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1002" y="488" width="236" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-lg2" value="Planned, not started" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1002" y="524" width="236" height="28" as="geometry"/></mxCell>
