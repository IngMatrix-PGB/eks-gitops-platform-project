{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "postgres-lab values (Phase 6.3b, ADR-0023)",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "database", "appUser", "storage", "resources", "credentials", "networkPolicy", "dump"],
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "database": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
    "appUser": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$", "not": {"enum": ["postgres"]}},
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["size", "storageClassName"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"},
        "storageClassName": {"type": "string"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["memory"],
          "properties": {"memory": {"type": "string"}}}
      }
    },
    "credentials": {
      "type": "object", "additionalProperties": false,
      "required": ["secretStoreName", "authServiceAccountName", "sourceNamespace", "sourceSecretName", "refreshInterval"],
      "properties": {
        "secretStoreName": {"type": "string", "minLength": 1},
        "authServiceAccountName": {"type": "string", "minLength": 1},
        "sourceNamespace": {"type": "string", "minLength": 1},
        "sourceSecretName": {"type": "string", "minLength": 1},
        "refreshInterval": {"type": "string", "pattern": "^[0-9]+[smh]$"}
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false, "required": ["clientPodLabels"],
      "properties": {
        "clientPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
      }
    },
    "dump": {
      "description": "Phase 6.3d: logical dumps to the lab object store.",
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "schedule", "keep", "image", "storeEndpoint", "storeCIDR", "storePort", "sourceSecretName", "bucket", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "pattern": "^[0-9*/,-]+( [0-9*/,-]+){4}$"},
        "keep": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
        "image": {
          "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$"},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "storeEndpoint": {"type": "string", "pattern": "^http://[a-z0-9.-]+:[0-9]{1,5}$"},
        "storeCIDR": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$"},
        "storePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "sourceSecretName": {"type": "string", "pattern": "^([a-z0-9][a-z0-9-]{0,62})?$"},
        "bucket": {"type": "string", "pattern": "^([a-z0-9][a-z0-9-]{1,61}[a-z0-9])?$"},
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
          "properties": {
            "requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
              "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}},
            "limits": {"type": "object", "additionalProperties": false, "required": ["memory"],
              "properties": {"memory": {"type": "string"}}}
          }
        }
      }
    }
  }
}
